# העתיקו לקובץ בשם .env ומלאו את הערכים

# כתובת האתר הציבורית (משמשת לקישורים במיילים)
BASE_URL=https://meetings.example.com
PORT=3000

# מנהל ראשון – נוצר רק בהפעלה הראשונה, כשאין עדיין משתמשים
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_NAME=מנהל המערכת

# שליחת מיילים (SMTP). דוגמה ל-Gmail: יש ליצור "סיסמת אפליקציה" בחשבון Google
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
MAIL_FROM="תיאום פגישות <you@gmail.com>"

# סוכן AI (Claude). בלי מפתח – הסוכן עובד לפי כלל הרוב בלבד, בלי הסברים והצעות חכמות
# מפתח: https://console.anthropic.com
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# אזור הזמן של הפגישות, ואורך ברירת מחדל לפגישה בלי שעת סיום (בדקות)
TIMEZONE=Asia/Jerusalem
MEETING_MINUTES=60

# מסד נתונים חיצוני (Postgres, למשל Neon). כשמוגדר – הנתונים נשמרים שם.
# כשריק – נשמרים בקובץ מקומי (data/app.db), מתאים לבדיקה במחשב.
DATABASE_URL=

# תיקיית מסד הנתונים המקומי (ברירת מחדל: ./data)
# DATA_DIR=/var/data
